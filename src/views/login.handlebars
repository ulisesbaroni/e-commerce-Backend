<div class="auth-form">
  <h1>Iniciar sesión</h1>

  {{#if reset}}
    <p class="mensaje-ok">Contraseña actualizada. Ya podés ingresar con la nueva.</p>
  {{/if}}

  <form id="form-login">
    <input type="email" id="email" placeholder="Email" required />
    <input type="password" id="password" placeholder="Contraseña" required />
    <button type="submit">Ingresar</button>
  </form>

  <p id="mensaje" class="mensaje-error"></p>

  <p><a href="/forgot-password">¿Olvidaste tu contraseña?</a></p>
  <p>¿No tenés cuenta? <a href="/register">Registrate</a></p>
</div>
