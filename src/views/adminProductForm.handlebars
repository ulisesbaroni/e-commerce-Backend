<div class="form-admin">
  <a href="/admin/products">← Volver al listado</a>

  <h1>{{#if product.id}}Editar producto{{else}}Nuevo producto{{/if}}</h1>

  <form id="form-producto" data-product-id="{{product.id}}">
    <label for="title">Título</label>
    <input type="text" id="title" value="{{product.title}}" required />

    <label for="description">Descripción</label>
    <textarea id="description" rows="4" required>{{product.description}}</textarea>

    <label for="code">Código</label>
    <input type="text" id="code" value="{{product.code}}" required />

    <label for="category">Categoría</label>
    <input type="text" id="category" value="{{product.category}}" required />

    <label for="price">Precio</label>
    <input type="number" id="price" min="0" step="0.01" value="{{product.price}}" required />

    <label for="stock">Stock</label>
    <input type="number" id="stock" min="0" step="1" value="{{product.stock}}" required />

    <label for="thumbnails">Imágenes (una URL por línea)</label>
    <textarea id="thumbnails" rows="3">{{thumbnailsText}}</textarea>

    <label class="check">
      <input type="checkbox" id="status" {{#if product.status}}checked{{/if}} />
      Producto activo (visible en la tienda)
    </label>

    <button type="submit">Guardar</button>
  </form>

  <p id="mensaje" class="mensaje-error"></p>
</div>

<script src="/js/admin.js"></script>
