<div class="auth-form">
  <h1>Nueva contraseña</h1>

  {{#if token}}
    <form id="form-reset" data-token="{{token}}">
      <input type="password" id="password" placeholder="Nueva contraseña" minlength="6" required />
      <input type="password" id="password-confirm" placeholder="Repetí la nueva contraseña" minlength="6" required />
      <button type="submit">Guardar contraseña</button>
    </form>

    <p id="mensaje" class="mensaje-error"></p>
  {{else}}
    <p class="mensaje-error">El enlace es inválido o venció.</p>
    <p><a href="/forgot-password">Pedir un enlace nuevo</a></p>
  {{/if}}
</div>
