<div class="landing">
  <h1>Bienvenido a la tienda</h1>
  <p>Remeras, buzos y más. Elegí por dónde empezar:</p>

  <div class="landing-cards">
    <a class="landing-card" href="/products">
      <h2>Ver productos</h2>
      <p>Catálogo completo, con filtros y paginación</p>
    </a>
    {{#if user.cart}}
      <a class="landing-card" href="/carts/{{user.cart}}">
        <h2>Mi carrito</h2>
        <p>Revisá lo que agregaste</p>
      </a>
    {{else}}
      {{#unless user}}
        <a class="landing-card" href="/register">
          <h2>Crear cuenta</h2>
          <p>Registrate para empezar a comprar</p>
        </a>
      {{/unless}}
    {{/if}}
  </div>
</div>
