MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/ecommerce
JWT_SECRET=<una_cadena_larga_y_aleatoria>
ADMIN_EMAIL=admin@ecommerce.com
ADMIN_PASSWORD=<contraseña_del_administrador>

# URL pública de la app: se usa para armar el enlace del mail de recuperación de contraseña
APP_URL=http://localhost:8080

# Mail (opcional). Si no se define SMTP_HOST se usa una cuenta de prueba de Ethereal:
# no envía mails reales y el enlace para ver el mail se imprime en la consola del servidor.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=<usuario_smtp>
# SMTP_PASS=<contraseña_o_app_password>
# MAIL_FROM="Tienda" <no-reply@tienda.com>
